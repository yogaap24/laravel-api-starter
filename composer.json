{
    "name": "kindharika/laravel-api-starter",
    "description": "Production-ready Laravel API starter: service layer, UUID models, datatable macro, CRUD scaffold with OpenAPI/Swagger.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "api",
        "starter",
        "scaffold",
        "crud",
        "modular",
        "module",
        "rbac",
        "sso",
        "socialite",
        "google",
        "openapi",
        "swagger",
        "datatable",
        "uuid",
        "service-layer"
    ],
    "homepage": "https://github.com/yogaap24/laravel-api-starter",
    "support": {
        "issues": "https://github.com/yogaap24/laravel-api-starter/issues",
        "source": "https://github.com/yogaap24/laravel-api-starter"
    },
    "authors": [
        {
            "name": "Kindharika",
            "email": "kindharika@example.com"
        }
    ],
    "require": {
        "php": "^8.3",
        "illuminate/console": "^11.0 || ^12.0 || ^13.0",
        "illuminate/database": "^11.0 || ^12.0 || ^13.0",
        "illuminate/http": "^11.0 || ^12.0 || ^13.0",
        "illuminate/routing": "^11.0 || ^12.0 || ^13.0",
        "illuminate/support": "^11.0 || ^12.0 || ^13.0",
        "ramsey/uuid": "^4.7"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0 || ^10.0 || ^11.0",
        "phpunit/phpunit": "^11.0 || ^12.0"
    },
    "autoload": {
        "psr-4": {
            "Kindharika\\ApiStarter\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Kindharika\\ApiStarter\\Tests\\": "tests/"
        }
    },
    "suggest": {
        "laravel/sanctum": "Required when API_STARTER_AUTH=true, scaffolding with --auth, or after SSO login",
        "laravel/socialite": "Required for api:make-sso (Google + any OAuth provider)",
        "spatie/laravel-permission": "Optional RBAC driver when API_STARTER_RBAC=true (driver=spatie)"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Kindharika\\ApiStarter\\ApiStarterServiceProvider"
            ]
        },
        "branch-alias": {
            "dev-master": "2.x-dev",
            "dev-main": "2.x-dev"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
