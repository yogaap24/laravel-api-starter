<?php

declare(strict_types=1);

namespace {{namespace}}\Services\{{modelClass}};

use {{namespace}}\Models\{{modelClass}};
use Illuminate\Contracts\Pagination\LengthAwarePaginator;
use Illuminate\Database\Eloquent\Model;
use Illuminate\Foundation\Http\FormRequest;
use Kindharika\ApiStarter\Base\BaseService;
use Kindharika\ApiStarter\Base\BaseServiceInterface;
use Kindharika\ApiStarter\Support\DatatableFilter;

/**
 * Module service for {{modelClass}} CRUD + datatable.
 */
class {{class}} extends BaseService implements BaseServiceInterface
{
    public function __construct({{modelClass}} $model)
    {
        parent::__construct($model);
    }

    /**
     * @param  DatatableFilter|array<string, string|int|float|bool|null>  $filter
     * @return LengthAwarePaginator<int, {{modelClass}}>
     */
    public function dataTable(DatatableFilter|array $filter): LengthAwarePaginator
    {
        $filter = $filter instanceof DatatableFilter
            ? $filter
            : DatatableFilter::fromArray($filter);

        /** @var LengthAwarePaginator<int, {{modelClass}}> $paginator */
        $paginator = {{modelClass}}::query()
            ->datatable($filter->toArray())
            ->paginate($filter->entries);

        return $paginator;
    }

    public function getById(string $id): Model
    {
        return {{modelClass}}::query()->findOrFail($id);
    }

    /**
     * @param  FormRequest|array<string, string|int|float|bool|null|array<int|string, string|int|float|bool|null>>  $data
     */
    public function create(FormRequest|array $data): Model
    {
        return {{modelClass}}::query()->create($this->extractPayload($data));
    }

    /**
     * @param  FormRequest|array<string, string|int|float|bool|null|array<int|string, string|int|float|bool|null>>  $data
     */
    public function update(string $id, FormRequest|array $data): Model
    {
        $model = {{modelClass}}::query()->findOrFail($id);
        $model->update($this->extractPayload($data));

        /** @var {{modelClass}} $fresh */
        $fresh = $model->fresh();

        return $fresh;
    }

    public function delete(string $id): Model
    {
        $model = {{modelClass}}::query()->findOrFail($id);
        $model->delete();

        return $model;
    }
}
