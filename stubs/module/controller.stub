<?php

declare(strict_types=1);

namespace {{namespace}}\Http\Controllers;

use {{namespace}}\Http\Requests\{{modelClass}}\Store{{modelClass}}Request;
use {{namespace}}\Http\Requests\{{modelClass}}\Update{{modelClass}}Request;
use {{namespace}}\Http\Resources\{{modelClass}}Resource;
use {{namespace}}\Models\{{modelClass}};
use {{namespace}}\Services\{{modelClass}}\{{modelClass}}Service;
use Illuminate\Contracts\Pagination\LengthAwarePaginator;
use Illuminate\Http\JsonResponse;
use Illuminate\Http\Request;
use Kindharika\ApiStarter\Base\BaseApiController;
use Kindharika\ApiStarter\Support\DatatableFilter;

/**
 * Module CRUD controller for {{modelClass}}.
 *
 * @OA\Schema(
 *     schema="{{modelClass}}",
 *     type="object",
{{openApiResourceProperties}}
 * )
 * @OA\Schema(
 *     schema="{{modelClass}}Store",
 *     type="object",
 *     {{openApiStoreRequired}}
{{openApiRequestProperties}}
 * )
 * @OA\Schema(
 *     schema="{{modelClass}}Update",
 *     type="object",
{{openApiRequestProperties}}
 * )
 */
class {{class}} extends BaseApiController
{
    public function __construct(
        protected {{modelClass}}Service $service,
        Request $request,
    ) {
        parent::__construct($request);
    }

    public function index(Request $request): JsonResponse
    {
        /** @var LengthAwarePaginator<int, {{modelClass}}> $paginator */
        $paginator = $this->service->dataTable(DatatableFilter::fromRequest($request));
        $paginator->through(fn ({{modelClass}} $item): array => (new {{modelClass}}Resource($item))->resolve());

        return $this->sendSuccess($paginator, null, 200);
    }

    public function store(Store{{modelClass}}Request $request): JsonResponse
    {
        /** @var {{modelClass}} $data */
        $data = $this->service->create($request);

        return $this->sendSuccess((new {{modelClass}}Resource($data))->resolve(), null, 201);
    }

    /**
     * @param  string  $id  UUID primary key
     */
    public function show(string $id): JsonResponse
    {
        /** @var {{modelClass}} $data */
        $data = $this->service->getById($id);

        return $this->sendSuccess((new {{modelClass}}Resource($data))->resolve(), null, 200);
    }

    /**
     * @param  string  $id  UUID primary key
     */
    public function update(Update{{modelClass}}Request $request, string $id): JsonResponse
    {
        /** @var {{modelClass}} $data */
        $data = $this->service->update($id, $request);

        return $this->sendSuccess((new {{modelClass}}Resource($data))->resolve(), null, 200);
    }

    /**
     * @param  string  $id  UUID primary key
     */
    public function destroy(string $id): JsonResponse
    {
        /** @var {{modelClass}} $data */
        $data = $this->service->delete($id);

        return $this->sendSuccess((new {{modelClass}}Resource($data))->resolve(), null, 200);
    }
}
