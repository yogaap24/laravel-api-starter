{
  "openapi": "3.0.3",
  "info": {
    "title": "{{title}} — {{module}}/{{modelClass}}",
    "version": "{{version}}"
  },
  "servers": [
    {
      "url": "{{serverUrl}}"
    }
  ],
  "tags": [
    {
      "name": "{{tag}}",
      "description": "Module {{module}} — {{modelClass}}"
    }
  ],
  "paths": {
    "/{{route}}": {
      "get": {
        "tags": ["{{tag}}"],
        "summary": "List {{modelClass}}",
        "operationId": "list{{module}}{{modelClass}}",
        "parameters": [
          {"name": "entries", "in": "query", "schema": {"type": "integer", "default": 15}},
          {"name": "search_key", "in": "query", "schema": {"type": "string"}},
          {"name": "search_columns", "in": "query", "schema": {"type": "string"}},
          {"name": "sort_column", "in": "query", "schema": {"type": "string"}},
          {"name": "sort_type", "in": "query", "schema": {"type": "string", "enum": ["asc", "desc"]}}
        ],
        "responses": {
          "200": {"description": "Paginated list"}
        }
      },
      "post": {
        "tags": ["{{tag}}"],
        "summary": "Create {{modelClass}}",
        "operationId": "create{{module}}{{modelClass}}",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {"$ref": "#/components/schemas/{{modelClass}}Store"}
            }
          }
        },
        "responses": {
          "201": {"description": "Created"},
          "422": {"description": "Validation error"}
        }
      }
    },
    "/{{route}}/{id}": {
      "get": {
        "tags": ["{{tag}}"],
        "summary": "Show {{modelClass}}",
        "operationId": "show{{module}}{{modelClass}}",
        "parameters": [
          {"name": "id", "in": "path", "required": true, "schema": {"type": "string", "format": "uuid"}}
        ],
        "responses": {
          "200": {"description": "OK"},
          "404": {"description": "Not found"}
        }
      },
      "put": {
        "tags": ["{{tag}}"],
        "summary": "Update {{modelClass}}",
        "operationId": "update{{module}}{{modelClass}}",
        "parameters": [
          {"name": "id", "in": "path", "required": true, "schema": {"type": "string", "format": "uuid"}}
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {"$ref": "#/components/schemas/{{modelClass}}Update"}
            }
          }
        },
        "responses": {
          "200": {"description": "Updated"},
          "404": {"description": "Not found"}
        }
      },
      "delete": {
        "tags": ["{{tag}}"],
        "summary": "Delete {{modelClass}}",
        "operationId": "delete{{module}}{{modelClass}}",
        "parameters": [
          {"name": "id", "in": "path", "required": true, "schema": {"type": "string", "format": "uuid"}}
        ],
        "responses": {
          "200": {"description": "Deleted"},
          "404": {"description": "Not found"}
        }
      }
    }
  },
  "components": {
    "schemas": {
      "{{modelClass}}": {
        "type": "object",
        "properties": {
          "id": {"type": "string", "format": "uuid"},
          "name": {"type": "string"},
          "description": {"type": "string", "nullable": true},
          "created_at": {"type": "string", "format": "date-time"},
          "updated_at": {"type": "string", "format": "date-time"}
        }
      },
      "{{modelClass}}Store": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": {"type": "string", "maxLength": 255},
          "description": {"type": "string", "nullable": true}
        }
      },
      "{{modelClass}}Update": {
        "type": "object",
        "properties": {
          "name": {"type": "string", "maxLength": 255},
          "description": {"type": "string", "nullable": true}
        }
      }
    }
  }
}
