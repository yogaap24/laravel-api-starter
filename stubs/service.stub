<?php

namespace {{namespace}}\Services\{{modelClass}};

use {{namespace}}\Models\{{modelClass}};
use Illuminate\Contracts\Pagination\LengthAwarePaginator;
use Illuminate\Foundation\Http\FormRequest;
use Kindharika\ApiStarter\Base\BaseService;
use Kindharika\ApiStarter\Base\BaseServiceInterface;

/**
 * Business logic for {{modelClass}} CRUD + datatable.
 */
class {{class}} extends BaseService implements BaseServiceInterface
{
    public function __construct({{modelClass}} $model)
    {
        parent::__construct($model);
    }

    /**
     * @param  array<string, mixed>|FormRequest|mixed  $filter
     * @return LengthAwarePaginator<int, {{modelClass}}>
     */
    public function dataTable(mixed $filter): mixed
    {
        $perPage = (int) ($filter['entries'] ?? config('api-starter.datatable.per_page', 15));

        return {{modelClass}}::query()
            ->datatable(is_array($filter) ? $filter : [])
            ->paginate($perPage);
    }

    /**
     * @param  string  $id  UUID primary key
     * @return {{modelClass}}
     */
    public function getById(mixed $id): mixed
    {
        return {{modelClass}}::query()->findOrFail($id);
    }

    /**
     * @param  FormRequest|array<string, mixed>|mixed  $data
     * @return {{modelClass}}
     */
    public function create(mixed $data): mixed
    {
        $payload = method_exists($data, 'validated') ? $data->validated() : (array) $data;

        return {{modelClass}}::query()->create($payload);
    }

    /**
     * @param  string  $id  UUID primary key
     * @param  FormRequest|array<string, mixed>|mixed  $data
     * @return {{modelClass}}
     */
    public function update(mixed $id, mixed $data): mixed
    {
        $model = {{modelClass}}::query()->findOrFail($id);
        $payload = method_exists($data, 'validated') ? $data->validated() : (array) $data;
        $model->update($payload);

        return $model->fresh();
    }

    /**
     * Soft-delete and return the deleted model.
     *
     * @param  string  $id  UUID primary key
     * @return {{modelClass}}
     */
    public function delete(mixed $id): mixed
    {
        $model = {{modelClass}}::query()->findOrFail($id);
        $model->delete();

        return $model;
    }
}
