<?php

declare(strict_types=1);

namespace {{namespace}}\Http\Requests\Auth;

use Illuminate\Foundation\Http\FormRequest;
use Illuminate\Validation\Validator;

/**
 * @property-read string|null $access_token
 * @property-read string|null $id_token
 *
 * @method array{access_token?: string, id_token?: string} validated($key = null, $default = null)
 */
class SocialTokenRequest extends FormRequest
{
    public function authorize(): bool
    {
        return true;
    }

    /**
     * @return array<string, list<string>>
     */
    public function rules(): array
    {
        return [
            'access_token' => ['nullable', 'string'],
            'id_token' => ['nullable', 'string'],
        ];
    }

    public function withValidator(Validator $validator): void
    {
        $validator->after(function (Validator $validator): void {
            if (! $this->filled('access_token') && ! $this->filled('id_token')) {
                $validator->errors()->add('access_token', 'Provide access_token or id_token.');
            }
        });
    }
}
